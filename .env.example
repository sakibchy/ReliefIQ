# ============================================================
# ReliefIQ — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── AI (Required) ────────────────────────────────────────────
# Gemma 4 via OpenRouter (OpenAI-compatible API, free tier, no billing required)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemma 4 model identifier
# Options: google/gemma-4-31b-it:free (flagship, multimodal, free tier),
# google/gemma-4-26b-a4b-it (MoE), google/gemma-4-12b-it / google/gemma-4-4b-it (smaller, faster)
GEMMA_MODEL=google/gemma-4-31b-it:free

# ── Weather (Required) ────────────────────────────────────────
# Get from: https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Database ──────────────────────────────────────────────────
# Local development: sqlite+aiosqlite:///./reliefiq.db
# Production (Pi):  sqlite+aiosqlite:////var/lib/reliefiq/reliefiq.db
DATABASE_URL=sqlite+aiosqlite:///./reliefiq.db

# ── File Storage ──────────────────────────────────────────────
# Directory where uploaded images are saved
UPLOAD_DIR=./uploads

# Max image size in MB (default: 10)
MAX_IMAGE_SIZE_MB=10

# Max images per report (default: 5)
MAX_IMAGES_PER_REPORT=5

# ── Security ──────────────────────────────────────────────────
# Random secret key for JWT signing — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_real_secret_key

# JWT token expiry in hours (default: 24)
ACCESS_TOKEN_EXPIRE_HOURS=24

# ── Admin Credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate hash with:
# python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('your_password'))"
ADMIN_PASSWORD_HASH=$2b$12$replacethiswitharealbcrypthashofyourpassword

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Dev: http://localhost:5173
# Prod: https://your-domain.com
CORS_ORIGINS=http://localhost:5173

# ── App Settings ──────────────────────────────────────────────
# Rate limit: max report submissions per hour per IP
RATE_LIMIT_REPORTS_PER_HOUR=10

# Environment: development | production
ENVIRONMENT=development

# ── Optional: Email Alerts ────────────────────────────────────
# Uncomment and fill to enable email alerts for Critical reports
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=admin@example.com
