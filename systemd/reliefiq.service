[Unit]
Description=ReliefIQ FastAPI Backend
After=network.target

[Service]
Type=exec
User=pi
Group=pi
WorkingDirectory=/opt/reliefiq/backend
EnvironmentFile=/opt/reliefiq/.env
ExecStart=/opt/reliefiq/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
